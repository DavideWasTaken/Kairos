# Docker Compose variables
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Backend runtime
KAIROS_DEMO=1
ALLOWED_ORIGINS=http://localhost:8080
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# The dashboard-to-chat snapshot cache is local to one backend process.
BACKEND_WORKERS=1
LOG_LEVEL=info

# Frontend build-time API base
VITE_API_URL=/api
